# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Abacus AI (get from https://abacus.ai)
ABACUSAI_API_KEY=your_abacusai_api_key
WEB_APP_ID=your_web_app_id
NOTIF_ID_LEAD_FORM_SUBMISSION=your_notification_id
NOTIF_ID_EMAIL_SIGNUP_10_OFF=your_notification_id

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# NextAuth
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=your-nextauth-secret-here

# Admin Dashboard
ADMIN_SECRET=your-secure-admin-secret

# CompanyCam
COMPANYCAM_API_KEY=your-companycam-api-key

# S3 (if using for images)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your-bucket-name
