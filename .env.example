# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# Abacus AI (get from https://abacus.ai)
ABACUSAI_API_KEY=your_abacusai_api_key
WEB_APP_ID=your_web_app_id
NOTIF_ID_LEAD_FORM_SUBMISSION=your_notification_id
NOTIF_ID_EMAIL_SIGNUP_10_OFF=your_notification_id

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# NextAuth (if using)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# S3 (if using for images)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your-bucket-name
